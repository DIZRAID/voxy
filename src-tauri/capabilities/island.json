{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "Островок: только события state/level, геометрия выреза, синхронизация состояния и отмена записи",
  "windows": ["island"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-island-metrics",
    "allow-island-sync",
    "allow-cancel-recording"
  ]
}

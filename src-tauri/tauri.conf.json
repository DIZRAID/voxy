{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxy",
  "version": "0.2.0",
  "identifier": "com.dizraid.voice",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "create": false,
        "url": "settings.html",
        "title": "Voxy",
        "width": 680,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "center": true,
        "decorations": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "backgroundColor": "#00000000",
        "trafficLightPosition": { "x": 19, "y": 28 },
        "windowEffects": {
          "effects": ["underWindowBackground"],
          "state": "active",
          "radius": 22
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "Productivity",
    "publisher": "DIZRAID",
    "homepage": "https://github.com/DIZRAID/voxy",
    "shortDescription": "Push-to-talk dictation",
    "longDescription": "Voxy — push-to-talk dictation with on-device speech recognition.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/nsis-sidebar.bmp",
        "headerImage": "windows/nsis-header.bmp",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}

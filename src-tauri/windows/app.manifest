<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest of every Windows (MSVC) binary of this package: the app
  (voxy.exe, Voxy.exe once bundled) and the unit-test binary of cargo test.

  build.rs hands it to link.exe (/MANIFEST:EMBED /MANIFESTINPUT:this file)
  instead of letting tauri-build put it into the resources, because
  tauri-build's resource reaches binaries only. Without it the test binary
  binds the Common Controls v5 comctl32.dll, which has no TaskDialogIndirect
  (imported through tao and muda), and dies at load with 0xC0000139 before
  any test runs (tauri-apps/tauri#13419).

  Content: the default manifest of tauri-build 2.6.3
  (src/windows-app-manifest.xml), the Common Controls 6.0 dependency.
  link.exe adds the default UAC section (requestedExecutionLevel asInvoker)
  by itself, so there is none here.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
